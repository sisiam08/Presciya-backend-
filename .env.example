# ─────────────────────────────────────────────────────────────────────────────
# Presciya backend — example environment file.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Values below are safe placeholders, not working credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Public URL of the web app. Used for password-reset / invitation / verification
# links and as the default allowed CORS origin.
APP_URL=http://localhost:3000

# Optional override when the API and web app are deployed on different hosts.
# Defaults to APP_URL.
# FRONTEND_URL=https://app.example.com

# Extra allowed CORS origins, comma separated (staging, previews…). APP_URL is
# always allowed. Never use "*" — credentialed cookie requests would break.
# CORS_ORIGIN=https://staging.example.com

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Authentication tokens ────────────────────────────────────────────────────
# Access token: short-lived, sent on every request.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Keep this short — the refresh token is what maintains the session.
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token: long-lived, used only to obtain new access tokens.
# MUST be a different secret from ACCESS_TOKEN_SECRET.
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret-min-32-chars
# How long a user can stay signed in without re-authenticating.
REFRESH_TOKEN_EXPIRES_IN=7d

# ── JWT claim validation ─────────────────────────────────────────────────────
# Tokens are issued with and verified against these values.
JWT_ISSUER=presciya-api
JWT_AUDIENCE=presciya-web

# ── Authentication cookies ───────────────────────────────────────────────────
# Cookie names and max-age are optional; max-age defaults to the matching
# token lifetime so a cookie can never outlive its token.
# ACCESS_TOKEN_COOKIE_NAME=accessToken
# REFRESH_TOKEN_COOKIE_NAME=refreshToken
# ACCESS_TOKEN_COOKIE_MAX_AGE=900000
# REFRESH_TOKEN_COOKIE_MAX_AGE=604800000

# secure defaults to true in production and false in development.
# COOKIE_SECURE=true
# lax | strict | none — defaults to strict in production, lax in development.
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
# COOKIE_PATH=/

# ── Sessions & one-time codes ────────────────────────────────────────────────
# Server-side session lifetime. Defaults to REFRESH_TOKEN_EXPIRES_IN.
# SESSION_EXPIRES_IN=7d
OTP_EXPIRES_IN=15m
PASSWORD_RESET_EXPIRES_IN=15m
INVITATION_EXPIRY_DAYS=7

# ── Password hashing ─────────────────────────────────────────────────────────
# bcrypt cost. Defaults to 12 in production and 10 in development.
BCRYPT_SALT_ROUND=10

# ── Rate limiting ────────────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# GENERAL_RATE_LIMIT=300
# AUTH_RATE_LIMIT=10
# PUBLIC_VERIFY_RATE_LIMIT=30

# ── Cloudinary (file/logo storage) ───────────────────────────────────────────
CLOUDEINARY_CLOUD_NAME=
CLOUDEINARY_API_KEY=
CLOUDEINARY_API_SECRET=

# ── Email / SMTP ─────────────────────────────────────────────────────────────
NODEMAILER_HOST=
NODEMAILER_PORT=587
APP_USER=
APP_PASSWORD=
